{
  "name": "plu-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Walmart produce PLU reference with SQLite and auth",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "dev": "node src/server.js",
    "build": "node scripts/build-client.js",
    "test": "node --test test/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsbarcode": "3.11.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
